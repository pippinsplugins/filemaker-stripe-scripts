# FileMaker Script: Create Stripe Connect Standard Account
# Purpose: Creates a new Standard connected account via the API and opens the
#          Stripe-hosted onboarding form for the user to complete setup
# Stripe API: POST https://api.stripe.com/v1/accounts
#             POST https://api.stripe.com/v1/account_links
#
# No server required. This script:
#   1. Creates a Standard account via API
#   2. Generates an Account Link (Stripe-hosted onboarding URL)
#   3. Opens the URL in the user's browser
#   4. The user completes identity verification, bank account setup, etc. on Stripe
#   5. After completion, Stripe redirects to your return_url (can be any simple page)
#   6. Run script 09 to verify onboarding is complete
#
# Standard accounts have full access to the Stripe Dashboard at dashboard.stripe.com
# and manage their own account settings, payouts, and disputes directly.
# ---

# Step 1: Get the platform's Stripe API key
Set Variable [ $apiKey ; Value: GetFieldValue("StripeConfig::ApiKey") ]

# Step 2: Collect user info from the current record
Set Variable [ $email ; Value: ConnectedAccounts::Email ]
Set Variable [ $country ; Value: ConnectedAccounts::Country ]  // 2-letter ISO code (US, GB, etc.)
Set Variable [ $businessType ; Value: ConnectedAccounts::BusinessType ]  // individual, company, non_profit

# Defaults
If [ IsEmpty($businessType) ]
    Set Variable [ $businessType ; Value: "individual" ]
End If
If [ IsEmpty($country) ]
    Set Variable [ $country ; Value: "US" ]
End If

# Step 3: Create the Standard account
Set Variable [ $postData ; Value:
    "type=standard" &
    "&country=" & $country &
    "&email=" & GetAsURLEncoded($email) &
    "&business_type=" & $businessType &
    "&capabilities[card_payments][requested]=true" &
    "&capabilities[transfers][requested]=true"
]

Set Variable [ $curlOptions ; Value:
    "-X POST" &
    " -H \"Authorization: Bearer " & $apiKey & "\"" &
    " -H \"Stripe-Version: 2025-04-30\"" &
    " -H \"Content-Type: application/x-www-form-urlencoded\"" &
    " -d \"" & $postData & "\""
]

Set Variable [ $response ; Value: "" ]
Insert from URL [ Select ; With dialog: Off ; Target: $response ;
    URL: "https://api.stripe.com/v1/accounts" ;
    cURL options: $curlOptions ]

# Step 4: Check for errors
Set Variable [ $errorMessage ; Value: JSONGetElement($response ; "error.message") ]
If [ not IsEmpty($errorMessage) ]
    Show Custom Dialog [ "Stripe Error" ; "Failed to create account: " & $errorMessage ]
    Exit Script [ Text Result: "error" ]
End If

Set Variable [ $accountID ; Value: JSONGetElement($response ; "id") ]

# Step 5: Store the account ID
Set Field [ ConnectedAccounts::StripeAccountID ; $accountID ]
Set Field [ ConnectedAccounts::OnboardingComplete ; 0 ]
Set Field [ ConnectedAccounts::IsConnected ; 1 ]
Set Field [ ConnectedAccounts::CreatedDate ; Get(CurrentTimestamp) ]
Commit Records/Requests [ With dialog: Off ]

# Step 6: Generate the onboarding Account Link
# return_url: where Stripe sends the user after they finish (any page works)
# refresh_url: where Stripe sends the user if the link expires (any page works)
Set Variable [ $returnUrl ; Value: GetFieldValue("StripeConfig::ConnectReturnURL") ]
Set Variable [ $refreshUrl ; Value: GetFieldValue("StripeConfig::ConnectRefreshURL") ]

If [ IsEmpty($returnUrl) ]
    Set Variable [ $returnUrl ; Value: "https://example.com/stripe/onboarding-complete" ]
End If
If [ IsEmpty($refreshUrl) ]
    Set Variable [ $refreshUrl ; Value: "https://example.com/stripe/onboarding-refresh" ]
End If

Set Variable [ $linkData ; Value:
    "account=" & $accountID &
    "&type=account_onboarding" &
    "&return_url=" & GetAsURLEncoded($returnUrl) &
    "&refresh_url=" & GetAsURLEncoded($refreshUrl)
]

Set Variable [ $curlOptions ; Value:
    "-X POST" &
    " -H \"Authorization: Bearer " & $apiKey & "\"" &
    " -H \"Stripe-Version: 2025-04-30\"" &
    " -H \"Content-Type: application/x-www-form-urlencoded\"" &
    " -d \"" & $linkData & "\""
]

Set Variable [ $linkResponse ; Value: "" ]
Insert from URL [ Select ; With dialog: Off ; Target: $linkResponse ;
    URL: "https://api.stripe.com/v1/account_links" ;
    cURL options: $curlOptions ]

Set Variable [ $errorMessage ; Value: JSONGetElement($linkResponse ; "error.message") ]
If [ not IsEmpty($errorMessage) ]
    Show Custom Dialog [ "Stripe Error" ;
        "Account created (" & $accountID & ") but failed to generate onboarding link: " & $errorMessage &
        "¶¶Run script 08 to generate a new onboarding link." ]
    Exit Script [ Text Result: $accountID ]
End If

# Step 7: Open the onboarding URL in the user's browser
Set Variable [ $onboardingUrl ; Value: JSONGetElement($linkResponse ; "url") ]
Open URL [ With dialog: Off ; $onboardingUrl ]

Show Custom Dialog [ "Onboarding Started" ;
    "Account created: " & $accountID &
    "¶¶The Stripe onboarding page has been opened in the browser. " &
    "The user should complete all steps." &
    "¶¶Once finished, run 'Check Account Status' (script 09) to confirm." ]

Exit Script [ Text Result: $accountID ]
