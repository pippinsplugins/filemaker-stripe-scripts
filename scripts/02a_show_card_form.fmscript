# FileMaker Script: Show Stripe Card Form
# Purpose: Loads the Stripe Elements card form in a Web Viewer so the user
#          can enter card details securely. Card numbers never touch FileMaker.
#
# Prerequisites:
#   - A Web Viewer object on your layout named "StripeCardForm"
#   - StripeConfig::PublishableKey field containing your pk_test_... or pk_live_... key
#   - Script "Stripe Attach Card" (02b) must exist — it's called by the JavaScript
#
# Flow:
#   1. This script loads the HTML form into the Web Viewer
#   2. User enters card details in Stripe's secure form
#   3. Stripe.js tokenizes the card → returns pm_xxx
#   4. JavaScript calls FileMaker.PerformScript("Stripe Attach Card", pm_data)
#   5. Script 02b attaches the card to the customer on the connected account
# ---

# Step 1: Get the publishable key
Set Variable [ $publishableKey ; Value: GetFieldValue("StripeConfig::PublishableKey") ]

If [ IsEmpty($publishableKey) ]
    Show Custom Dialog [ "Configuration Error" ;
        "Stripe Publishable Key is not configured." &
        "¶¶Add your pk_test_... or pk_live_... key to StripeConfig::PublishableKey." ]
    Exit Script [ Text Result: "error" ]
End If

# Step 2: Validate the customer exists
Set Variable [ $customerID ; Value: Customers::StripeCustomerID ]
If [ IsEmpty($customerID) ]
    Show Custom Dialog [ "Error" ; "This customer does not have a Stripe customer ID. Run 'Create Customer' first." ]
    Exit Script [ Text Result: "error" ]
End If

# Step 3: Build the HTML with the publishable key injected
# The HTML template has PUBLISHABLE_KEY as a placeholder
Set Variable [ $html ; Value:
    "<!DOCTYPE html>" &
    "<html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'>" &
    "<style>" &
    "* { box-sizing: border-box; margin: 0; padding: 0; }" &
    "body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #f6f9fc; padding: 20px; }" &
    ".container { max-width: 400px; margin: 0 auto; }" &
    "h2 { font-size: 18px; color: #32325d; margin-bottom: 16px; }" &
    "#card-element { background: white; padding: 12px; border: 1px solid #e0e0e0; border-radius: 6px; margin-bottom: 16px; }" &
    "#card-errors { color: #e25950; font-size: 13px; margin-bottom: 12px; min-height: 20px; }" &
    "button { background: #635bff; color: white; border: none; padding: 12px 24px; border-radius: 6px; font-size: 15px; cursor: pointer; width: 100%; font-weight: 600; }" &
    "button:hover { background: #524ddb; }" &
    "button:disabled { background: #aab7c4; cursor: not-allowed; }" &
    "#success-message { display: none; background: #d4edda; color: #155724; padding: 12px; border-radius: 6px; font-size: 14px; margin-top: 12px; }" &
    "</style></head><body>" &
    "<div class='container'>" &
    "<h2>Enter Card Details</h2>" &
    "<div id='card-element'></div>" &
    "<div id='card-errors'></div>" &
    "<button id='submit-btn' onclick='handleSubmit()'>Save Card</button>" &
    "<div id='success-message'></div>" &
    "</div>" &
    "<script src='https://js.stripe.com/v3/'></script>" &
    "<script>" &
    "var stripe = Stripe('" & $publishableKey & "');" &
    "var elements = stripe.elements();" &
    "var cardElement = elements.create('card', {" &
    "  style: { base: { fontSize: '16px', color: '#32325d', '::placeholder': { color: '#aab7c4' } }, invalid: { color: '#e25950' } }" &
    "});" &
    "cardElement.mount('#card-element');" &
    "cardElement.on('change', function(event) {" &
    "  document.getElementById('card-errors').textContent = event.error ? event.error.message : '';" &
    "});" &
    "function handleSubmit() {" &
    "  var btn = document.getElementById('submit-btn');" &
    "  btn.disabled = true; btn.textContent = 'Processing...';" &
    "  stripe.createPaymentMethod({ type: 'card', card: cardElement }).then(function(result) {" &
    "    if (result.error) {" &
    "      document.getElementById('card-errors').textContent = result.error.message;" &
    "      btn.disabled = false; btn.textContent = 'Save Card';" &
    "    } else {" &
    "      var pm = result.paymentMethod;" &
    "      document.getElementById('success-message').textContent = 'Card saved: ' + pm.card.brand + ' ending in ' + pm.card.last4;" &
    "      document.getElementById('success-message').style.display = 'block';" &
    "      btn.style.display = 'none';" &
    "      FileMaker.PerformScript('Stripe Attach Card', JSON.stringify({" &
    "        paymentMethodID: pm.id, last4: pm.card.last4, brand: pm.card.brand," &
    "        expMonth: pm.card.exp_month, expYear: pm.card.exp_year" &
    "      }));" &
    "    }" &
    "  });" &
    "}" &
    "</script></body></html>"
]

# Step 4: Load the HTML into the Web Viewer
Set Web Viewer [ Object Name: "StripeCardForm" ; URL: "data:text/html," & GetAsURLEncoded($html) ]

Exit Script [ Text Result: "loaded" ]
