<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
	<Step enable="True" id="89" name="Comment"><Text>Disconnect a Connected Stripe Account</Text></Step>
	<Step enable="True" id="89" name="Comment"><Text>Revokes the OAuth connection — user's Stripe account is not affected</Text></Step>
	<Step enable="True" id="89" name="Comment"><Text>---</Text></Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 1: Get platform credentials</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[GetFieldValue ( "StripeConfig::ApiKey" )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$apiKey</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[GetFieldValue ( "StripeConfig::ConnectClientID" )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$clientID</Name>
	</Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 2: Get the connected account ID</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[Get ( ScriptParameter )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$accountID</Name>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[IsEmpty ( $accountID )]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[ConnectedAccounts::StripeAccountID]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$accountID</Name>
	</Step>
	<Step enable="True" id="70" name="End If"></Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[IsEmpty ( $accountID )]]></Calculation>
	</Step>
	<Step enable="True" id="87" name="Show Custom Dialog">
		<Title><Calculation><![CDATA["Error"]]></Calculation></Title>
		<Message><Calculation><![CDATA["No connected account to disconnect."]]></Calculation></Message>
		<Buttons><Button><Name>OK</Name><CommitChanges>Yes</CommitChanges></Button></Buttons>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA["error"]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"></Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 3: Confirm disconnection</Text></Step>
	<Step enable="True" id="87" name="Show Custom Dialog">
		<Title><Calculation><![CDATA["Confirm Disconnect"]]></Calculation></Title>
		<Message><Calculation><![CDATA["Are you sure you want to disconnect Stripe account " & $accountID & "?" & ¶ & ¶ & "This will revoke your platform's access. You will no longer be able to create charges on this account. The user's Stripe account is not affected."]]></Calculation></Message>
		<Buttons>
			<Button><Name>Cancel</Name><CommitChanges>No</CommitChanges></Button>
			<Button><Name>Disconnect</Name><CommitChanges>Yes</CommitChanges></Button>
		</Buttons>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[Get ( LastMessageChoice ) = 1]]></Calculation>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA["cancelled"]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"></Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 4: Revoke the OAuth connection</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA["client_id=" & $clientID & "&stripe_user_id=" & $accountID]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$postData</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA["-X POST" & " -H \"Authorization: Bearer " & $apiKey & "\"" & " -H \"Content-Type: application/x-www-form-urlencoded\"" & " -d \"" & $postData & "\""]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$curlOptions</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[""]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$response</Name>
	</Step>
	<Step enable="True" id="136" name="Insert from URL">
		<SelectAll state="True"/>
		<NoDialog state="True"/>
		<Target><Variable value="$response"/></Target>
		<URL><Calculation><![CDATA["https://connect.stripe.com/oauth/deauthorize"]]></Calculation></URL>
		<cURLOptions><Calculation><![CDATA[$curlOptions]]></Calculation></cURLOptions>
	</Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 5: Check for errors</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[JSONGetElement ( $response ; "error_description" )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$errorMessage</Name>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( $errorMessage )]]></Calculation>
	</Step>
	<Step enable="True" id="87" name="Show Custom Dialog">
		<Title><Calculation><![CDATA["Stripe Error"]]></Calculation></Title>
		<Message><Calculation><![CDATA["Failed to disconnect: " & $errorMessage]]></Calculation></Message>
		<Buttons><Button><Name>OK</Name><CommitChanges>Yes</CommitChanges></Button></Buttons>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA["error"]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"></Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 6: Verify disconnection</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[JSONGetElement ( $response ; "stripe_user_id" )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$revokedID</Name>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[$revokedID = $accountID]]></Calculation>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Field table="ConnectedAccounts" id="0" name="IsConnected"/>
		<Calculation><![CDATA[0]]></Calculation>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Field table="ConnectedAccounts" id="0" name="ChargesEnabled"/>
		<Calculation><![CDATA[""]]></Calculation>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Field table="ConnectedAccounts" id="0" name="PayoutsEnabled"/>
		<Calculation><![CDATA[""]]></Calculation>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Field table="ConnectedAccounts" id="0" name="DisconnectedDate"/>
		<Calculation><![CDATA[Get ( CurrentTimestamp )]]></Calculation>
	</Step>
	<Step enable="True" id="75" name="Commit Records/Requests">
		<NoDialog state="True"/>
	</Step>
	<Step enable="True" id="87" name="Show Custom Dialog">
		<Title><Calculation><![CDATA["Disconnected"]]></Calculation></Title>
		<Message><Calculation><![CDATA["Stripe account " & $accountID & " has been disconnected."]]></Calculation></Message>
		<Buttons><Button><Name>OK</Name><CommitChanges>Yes</CommitChanges></Button></Buttons>
	</Step>
	<Step enable="True" id="69" name="Else"></Step>
	<Step enable="True" id="87" name="Show Custom Dialog">
		<Title><Calculation><![CDATA["Warning"]]></Calculation></Title>
		<Message><Calculation><![CDATA["Unexpected response. Check the account status manually."]]></Calculation></Message>
		<Buttons><Button><Name>OK</Name><CommitChanges>Yes</CommitChanges></Button></Buttons>
	</Step>
	<Step enable="True" id="70" name="End If"></Step>

	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA["success"]]></Calculation>
	</Step>
</fmxmlsnippet>
