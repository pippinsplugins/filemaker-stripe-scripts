<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
	<Step enable="True" id="89" name="Comment"><Text>Update a Stored Card — updates billing details on an existing PaymentMethod</Text></Step>
	<Step enable="True" id="89" name="Comment"><Text>Cannot update card number/exp/CVC — delete and re-add for that</Text></Step>
	<Step enable="True" id="89" name="Comment"><Text>---</Text></Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 1: Get the Stripe API key</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[GetFieldValue ( "StripeConfig::ApiKey" )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$apiKey</Name>
	</Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 2: Get the PaymentMethod ID to update</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[Get ( ScriptParameter )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$paymentMethodID</Name>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[IsEmpty ( $paymentMethodID )]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[PaymentMethods::StripePaymentMethodID]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$paymentMethodID</Name>
	</Step>
	<Step enable="True" id="70" name="End If"></Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[IsEmpty ( $paymentMethodID )]]></Calculation>
	</Step>
	<Step enable="True" id="87" name="Show Custom Dialog">
		<Title><Calculation><![CDATA["Error"]]></Calculation></Title>
		<Message><Calculation><![CDATA["No payment method specified to update."]]></Calculation></Message>
		<Buttons><Button><Name>OK</Name><CommitChanges>Yes</CommitChanges></Button></Buttons>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA["error"]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"></Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 3: Collect updated billing details</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[Customers::FirstName & " " & Customers::LastName]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$billingName</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[Customers::Email]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$billingEmail</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[Customers::Phone]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$billingPhone</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[Customers::Address1]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$billingLine1</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[Customers::Address2]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$billingLine2</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[Customers::City]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$billingCity</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[Customers::State]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$billingState</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[Customers::PostalCode]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$billingPostal</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[Customers::Country]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$billingCountry</Name>
	</Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 4: Build the update request</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA["billing_details[name]=" & GetAsURLEncoded ( $billingName ) & "&billing_details[email]=" & GetAsURLEncoded ( $billingEmail ) & "&billing_details[phone]=" & GetAsURLEncoded ( $billingPhone ) & "&billing_details[address][line1]=" & GetAsURLEncoded ( $billingLine1 ) & "&billing_details[address][line2]=" & GetAsURLEncoded ( $billingLine2 ) & "&billing_details[address][city]=" & GetAsURLEncoded ( $billingCity ) & "&billing_details[address][state]=" & GetAsURLEncoded ( $billingState ) & "&billing_details[address][postal_code]=" & GetAsURLEncoded ( $billingPostal ) & "&billing_details[address][country]=" & GetAsURLEncoded ( $billingCountry )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$postData</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA["-X POST" & " -H \"Authorization: Bearer " & $apiKey & "\"" & " -H \"Stripe-Version: 2025-04-30\"" & " -H \"Content-Type: application/x-www-form-urlencoded\"" & " -d \"" & $postData & "\""]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$curlOptions</Name>
	</Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 5: Send the update request</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[""]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$response</Name>
	</Step>
	<Step enable="True" id="136" name="Insert from URL">
		<SelectAll state="True"/>
		<NoDialog state="True"/>
		<Target><Variable value="$response"/></Target>
		<URL><Calculation><![CDATA["https://api.stripe.com/v1/payment_methods/" & $paymentMethodID]]></Calculation></URL>
		<cURLOptions><Calculation><![CDATA[$curlOptions]]></Calculation></cURLOptions>
	</Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 6: Check for errors</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[JSONGetElement ( $response ; "error.message" )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$errorMessage</Name>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( $errorMessage )]]></Calculation>
	</Step>
	<Step enable="True" id="87" name="Show Custom Dialog">
		<Title><Calculation><![CDATA["Stripe Error"]]></Calculation></Title>
		<Message><Calculation><![CDATA["Failed to update payment method: " & $errorMessage]]></Calculation></Message>
		<Buttons><Button><Name>OK</Name><CommitChanges>Yes</CommitChanges></Button></Buttons>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA["error"]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"></Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 7: Confirm the update</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[JSONGetElement ( $response ; "billing_details.name" )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$updatedName</Name>
	</Step>
	<Step enable="True" id="87" name="Show Custom Dialog">
		<Title><Calculation><![CDATA["Success"]]></Calculation></Title>
		<Message><Calculation><![CDATA["Payment method updated for: " & $updatedName]]></Calculation></Message>
		<Buttons><Button><Name>OK</Name><CommitChanges>Yes</CommitChanges></Button></Buttons>
	</Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 8: Update the local FileMaker record if on PaymentMethods layout</Text></Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[Get ( LayoutName ) = "PaymentMethods"]]></Calculation>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Field table="PaymentMethods" id="0" name="BillingName"/>
		<Calculation><![CDATA[$updatedName]]></Calculation>
	</Step>
	<Step enable="True" id="75" name="Commit Records/Requests">
		<NoDialog state="True"/>
	</Step>
	<Step enable="True" id="70" name="End If"></Step>

	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA["success"]]></Calculation>
	</Step>
</fmxmlsnippet>
