<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
	<Step enable="True" id="89" name="Comment"><Text>Delete a Stored Card</Text></Step>
	<Step enable="True" id="89" name="Comment"><Text>Detaches a PaymentMethod from a customer</Text></Step>
	<Step enable="True" id="89" name="Comment"><Text>---</Text></Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 1: Get the Stripe API key</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[GetFieldValue ( "StripeConfig::ApiKey" )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$apiKey</Name>
	</Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 2: Get the PaymentMethod ID to delete</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[Get ( ScriptParameter )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$paymentMethodID</Name>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[IsEmpty ( $paymentMethodID )]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[PaymentMethods::StripePaymentMethodID]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$paymentMethodID</Name>
	</Step>
	<Step enable="True" id="70" name="End If"></Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[IsEmpty ( $paymentMethodID )]]></Calculation>
	</Step>
	<Step enable="True" id="87" name="Show Custom Dialog">
		<Title><Calculation><![CDATA["Error"]]></Calculation></Title>
		<Message><Calculation><![CDATA["No payment method specified to delete."]]></Calculation></Message>
		<Buttons><Button><Name>OK</Name><CommitChanges>Yes</CommitChanges></Button></Buttons>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA["error"]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"></Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 3: Confirm deletion</Text></Step>
	<Step enable="True" id="87" name="Show Custom Dialog">
		<Title><Calculation><![CDATA["Confirm Delete"]]></Calculation></Title>
		<Message><Calculation><![CDATA["Are you sure you want to remove this stored card (" & $paymentMethodID & ")?"]]></Calculation></Message>
		<Buttons>
			<Button><Name>Cancel</Name><CommitChanges>No</CommitChanges></Button>
			<Button><Name>Delete</Name><CommitChanges>Yes</CommitChanges></Button>
		</Buttons>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[Get ( LastMessageChoice ) = 1]]></Calculation>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA["cancelled"]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"></Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 4: Detach the PaymentMethod</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA["-X POST" & " -H \"Authorization: Bearer " & $apiKey & "\"" & " -H \"Stripe-Version: 2025-04-30\""]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$curlOptions</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[""]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$response</Name>
	</Step>
	<Step enable="True" id="136" name="Insert from URL">
		<SelectAll state="True"/>
		<NoDialog state="True"/>
		<Target><Variable value="$response"/></Target>
		<URL><Calculation><![CDATA["https://api.stripe.com/v1/payment_methods/" & $paymentMethodID & "/detach"]]></Calculation></URL>
		<cURLOptions><Calculation><![CDATA[$curlOptions]]></Calculation></cURLOptions>
	</Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 5: Check for errors</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[JSONGetElement ( $response ; "error.message" )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$errorMessage</Name>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( $errorMessage )]]></Calculation>
	</Step>
	<Step enable="True" id="87" name="Show Custom Dialog">
		<Title><Calculation><![CDATA["Stripe Error"]]></Calculation></Title>
		<Message><Calculation><![CDATA["Failed to delete payment method: " & $errorMessage]]></Calculation></Message>
		<Buttons><Button><Name>OK</Name><CommitChanges>Yes</CommitChanges></Button></Buttons>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA["error"]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"></Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 6: Verify detachment</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[JSONGetElement ( $response ; "customer" )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$customer</Name>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[IsEmpty ( $customer ) or $customer = "null"]]></Calculation>
	</Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 7: Check if this was the default</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[Customers::DefaultPaymentMethod = $paymentMethodID]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$wasDefault</Name>
	</Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 8: Delete the local FileMaker record</Text></Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[Get ( LayoutName ) = "PaymentMethods"]]></Calculation>
	</Step>
	<Step enable="True" id="31" name="Delete Record/Request">
		<NoDialog state="True"/>
	</Step>
	<Step enable="True" id="69" name="Else"></Step>
	<Step enable="True" id="6" name="Go to Layout">
		<Layout id="0" name="PaymentMethods"/>
		<Animation value="None"/>
	</Step>
	<Step enable="True" id="22" name="Enter Find Mode">
		<Pause state="False"/>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Field table="PaymentMethods" id="0" name="StripePaymentMethodID"/>
		<Calculation><![CDATA[$paymentMethodID]]></Calculation>
	</Step>
	<Step enable="True" id="28" name="Perform Find"></Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[Get ( FoundCount ) > 0]]></Calculation>
	</Step>
	<Step enable="True" id="31" name="Delete Record/Request">
		<NoDialog state="True"/>
	</Step>
	<Step enable="True" id="70" name="End If"></Step>
	<Step enable="True" id="6" name="Go to Layout">
		<Layout id="0" name="" destination="OriginalLayout"/>
	</Step>
	<Step enable="True" id="70" name="End If"></Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 9: Clear default if needed</Text></Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[$wasDefault]]></Calculation>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Field table="Customers" id="0" name="DefaultPaymentMethod"/>
		<Calculation><![CDATA[""]]></Calculation>
	</Step>
	<Step enable="True" id="75" name="Commit Records/Requests">
		<NoDialog state="True"/>
	</Step>
	<Step enable="True" id="70" name="End If"></Step>

	<Step enable="True" id="87" name="Show Custom Dialog">
		<Title><Calculation><![CDATA["Success"]]></Calculation></Title>
		<Message><Calculation><![CDATA["Card removed successfully."]]></Calculation></Message>
		<Buttons><Button><Name>OK</Name><CommitChanges>Yes</CommitChanges></Button></Buttons>
	</Step>
	<Step enable="True" id="69" name="Else"></Step>
	<Step enable="True" id="87" name="Show Custom Dialog">
		<Title><Calculation><![CDATA["Warning"]]></Calculation></Title>
		<Message><Calculation><![CDATA["Unexpected response — card may not have been fully detached."]]></Calculation></Message>
		<Buttons><Button><Name>OK</Name><CommitChanges>Yes</CommitChanges></Button></Buttons>
	</Step>
	<Step enable="True" id="70" name="End If"></Step>

	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA["success"]]></Calculation>
	</Step>
</fmxmlsnippet>
