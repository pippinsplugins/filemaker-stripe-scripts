<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
	<Step enable="True" id="89" name="Comment"><Text>Complete Account Connection</Text></Step>
	<Step enable="True" id="89" name="Comment"><Text>Exchanges the OAuth authorization code for the connected account ID</Text></Step>
	<Step enable="True" id="89" name="Comment"><Text>---</Text></Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 1: Get the platform's Stripe API key</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[GetFieldValue ( "StripeConfig::ApiKey" )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$apiKey</Name>
	</Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 2: Get the authorization code</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[Get ( ScriptParameter )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$authCode</Name>
	</Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[IsEmpty ( $authCode )]]></Calculation>
	</Step>
	<Step enable="True" id="87" name="Show Custom Dialog">
		<Title><Calculation><![CDATA["Enter Authorization Code"]]></Calculation></Title>
		<Message><Calculation><![CDATA["Paste the authorization code from the browser URL bar." & ¶ & ¶ & "It starts with 'ac_' and appears after '?code=' in the URL."]]></Calculation></Message>
		<Buttons>
			<Button><Name>Cancel</Name><CommitChanges>No</CommitChanges></Button>
			<Button><Name>OK</Name><CommitChanges>Yes</CommitChanges></Button>
		</Buttons>
		<InputFields>
			<InputField><Field table="ConnectedAccounts" id="0" name="TempAuthCode"/></InputField>
		</InputFields>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[Get ( LastMessageChoice ) = 1]]></Calculation>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA["cancelled"]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[ConnectedAccounts::TempAuthCode]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$authCode</Name>
	</Step>
	<Step enable="True" id="70" name="End If"></Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[IsEmpty ( $authCode )]]></Calculation>
	</Step>
	<Step enable="True" id="87" name="Show Custom Dialog">
		<Title><Calculation><![CDATA["Error"]]></Calculation></Title>
		<Message><Calculation><![CDATA["No authorization code provided."]]></Calculation></Message>
		<Buttons><Button><Name>OK</Name><CommitChanges>Yes</CommitChanges></Button></Buttons>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA["error"]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"></Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 3: Exchange the authorization code for the account ID</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA["grant_type=authorization_code" & "&code=" & $authCode]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$postData</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA["-X POST" & " -H \"Authorization: Bearer " & $apiKey & "\"" & " -H \"Content-Type: application/x-www-form-urlencoded\"" & " -d \"" & $postData & "\""]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$curlOptions</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[""]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$response</Name>
	</Step>
	<Step enable="True" id="136" name="Insert from URL">
		<SelectAll state="True"/>
		<NoDialog state="True"/>
		<Target><Variable value="$response"/></Target>
		<URL><Calculation><![CDATA["https://connect.stripe.com/oauth/token"]]></Calculation></URL>
		<cURLOptions><Calculation><![CDATA[$curlOptions]]></Calculation></cURLOptions>
	</Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 4: Check for errors</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[JSONGetElement ( $response ; "error_description" )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$errorMessage</Name>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( $errorMessage )]]></Calculation>
	</Step>
	<Step enable="True" id="87" name="Show Custom Dialog">
		<Title><Calculation><![CDATA["Stripe Error"]]></Calculation></Title>
		<Message><Calculation><![CDATA["Failed to connect account: " & $errorMessage]]></Calculation></Message>
		<Buttons><Button><Name>OK</Name><CommitChanges>Yes</CommitChanges></Button></Buttons>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA["error"]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"></Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 5: Extract the connected account ID</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[JSONGetElement ( $response ; "stripe_user_id" )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$accountID</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[JSONGetElement ( $response ; "livemode" )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$livemode</Name>
	</Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 6: Store the connected account in FileMaker</Text></Step>
	<Step enable="True" id="76" name="Set Field">
		<Field table="ConnectedAccounts" id="0" name="StripeAccountID"/>
		<Calculation><![CDATA[$accountID]]></Calculation>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Field table="ConnectedAccounts" id="0" name="Livemode"/>
		<Calculation><![CDATA[$livemode]]></Calculation>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Field table="ConnectedAccounts" id="0" name="IsConnected"/>
		<Calculation><![CDATA[1]]></Calculation>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Field table="ConnectedAccounts" id="0" name="ConnectedDate"/>
		<Calculation><![CDATA[Get ( CurrentTimestamp )]]></Calculation>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Field table="ConnectedAccounts" id="0" name="TempAuthCode"/>
		<Calculation><![CDATA[""]]></Calculation>
	</Step>
	<Step enable="True" id="75" name="Commit Records/Requests">
		<NoDialog state="True"/>
	</Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 7: Retrieve account details to confirm the connection</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$curlOptions</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[""]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$acctResponse</Name>
	</Step>
	<Step enable="True" id="136" name="Insert from URL">
		<SelectAll state="True"/>
		<NoDialog state="True"/>
		<Target><Variable value="$acctResponse"/></Target>
		<URL><Calculation><![CDATA["https://api.stripe.com/v1/accounts/" & $accountID]]></Calculation></URL>
		<cURLOptions><Calculation><![CDATA[$curlOptions]]></Calculation></cURLOptions>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[JSONGetElement ( $acctResponse ; "business_profile.name" )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$businessName</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[JSONGetElement ( $acctResponse ; "charges_enabled" )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$chargesEnabled</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[JSONGetElement ( $acctResponse ; "payouts_enabled" )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$payoutsEnabled</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[JSONGetElement ( $acctResponse ; "email" )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$email</Name>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Field table="ConnectedAccounts" id="0" name="BusinessName"/>
		<Calculation><![CDATA[$businessName]]></Calculation>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Field table="ConnectedAccounts" id="0" name="ChargesEnabled"/>
		<Calculation><![CDATA[$chargesEnabled]]></Calculation>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Field table="ConnectedAccounts" id="0" name="PayoutsEnabled"/>
		<Calculation><![CDATA[$payoutsEnabled]]></Calculation>
	</Step>
	<Step enable="True" id="75" name="Commit Records/Requests">
		<NoDialog state="True"/>
	</Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 8: Confirm the connection</Text></Step>
	<Step enable="True" id="87" name="Show Custom Dialog">
		<Title><Calculation><![CDATA["Account Connected"]]></Calculation></Title>
		<Message><Calculation><![CDATA["Stripe account successfully connected!" & ¶ & ¶ & "Account ID: " & $accountID & ¶ & "Business: " & $businessName & ¶ & "Email: " & $email & ¶ & "Charges enabled: " & $chargesEnabled & ¶ & "Mode: " & If ( $livemode = "true" ; "Live" ; "Test" )]]></Calculation></Message>
		<Buttons><Button><Name>OK</Name><CommitChanges>Yes</CommitChanges></Button></Buttons>
	</Step>

	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[$accountID]]></Calculation>
	</Step>
</fmxmlsnippet>
