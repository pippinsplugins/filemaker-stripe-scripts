<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
	<Step enable="True" id="89" name="Comment"><Text>Add Credit Card to Stripe Customer</Text></Step>
	<Step enable="True" id="89" name="Comment"><Text>Attaches a PaymentMethod (card) to a customer and stores the token in FileMaker</Text></Step>
	<Step enable="True" id="89" name="Comment"><Text>---</Text></Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 1: Get the Stripe API key</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[GetFieldValue ( "StripeConfig::ApiKey" )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$apiKey</Name>
	</Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 2: Get the customer's Stripe ID</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[Customers::StripeCustomerID]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$customerID</Name>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[IsEmpty ( $customerID )]]></Calculation>
	</Step>
	<Step enable="True" id="87" name="Show Custom Dialog">
		<Title><Calculation><![CDATA["Error"]]></Calculation></Title>
		<Message><Calculation><![CDATA["This customer does not have a Stripe customer ID. Run 'Create Customer' first."]]></Calculation></Message>
		<Buttons><Button><Name>OK</Name><CommitChanges>Yes</CommitChanges></Button></Buttons>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA["error"]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"></Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 3: Collect card details (TESTING ONLY)</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[Customers::TempCardNumber]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$cardNumber</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[Customers::TempExpMonth]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$expMonth</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[Customers::TempExpYear]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$expYear</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[Customers::TempCVC]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$cvc</Name>
	</Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 4: Create the PaymentMethod</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA["type=card" & "&card[number]=" & $cardNumber & "&card[exp_month]=" & $expMonth & "&card[exp_year]=" & $expYear & "&card[cvc]=" & $cvc]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$postData</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA["-X POST" & " -H \"Authorization: Bearer " & $apiKey & "\"" & " -H \"Stripe-Version: 2025-04-30\"" & " -H \"Content-Type: application/x-www-form-urlencoded\"" & " -d \"" & $postData & "\""]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$curlOptions</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[""]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$response</Name>
	</Step>
	<Step enable="True" id="136" name="Insert from URL">
		<SelectAll state="True"/>
		<NoDialog state="True"/>
		<Target><Variable value="$response"/></Target>
		<URL><Calculation><![CDATA["https://api.stripe.com/v1/payment_methods"]]></Calculation></URL>
		<cURLOptions><Calculation><![CDATA[$curlOptions]]></Calculation></cURLOptions>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[JSONGetElement ( $response ; "error.message" )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$errorMessage</Name>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( $errorMessage )]]></Calculation>
	</Step>
	<Step enable="True" id="87" name="Show Custom Dialog">
		<Title><Calculation><![CDATA["Stripe Error"]]></Calculation></Title>
		<Message><Calculation><![CDATA["Failed to create payment method: " & $errorMessage]]></Calculation></Message>
		<Buttons><Button><Name>OK</Name><CommitChanges>Yes</CommitChanges></Button></Buttons>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA["error"]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"></Step>

	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[JSONGetElement ( $response ; "id" )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$paymentMethodID</Name>
	</Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 5: Attach the PaymentMethod to the customer</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA["customer=" & $customerID]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$attachData</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA["-X POST" & " -H \"Authorization: Bearer " & $apiKey & "\"" & " -H \"Stripe-Version: 2025-04-30\"" & " -H \"Content-Type: application/x-www-form-urlencoded\"" & " -d \"" & $attachData & "\""]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$curlOptions</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[""]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$response</Name>
	</Step>
	<Step enable="True" id="136" name="Insert from URL">
		<SelectAll state="True"/>
		<NoDialog state="True"/>
		<Target><Variable value="$response"/></Target>
		<URL><Calculation><![CDATA["https://api.stripe.com/v1/payment_methods/" & $paymentMethodID & "/attach"]]></Calculation></URL>
		<cURLOptions><Calculation><![CDATA[$curlOptions]]></Calculation></cURLOptions>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[JSONGetElement ( $response ; "error.message" )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$errorMessage</Name>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( $errorMessage )]]></Calculation>
	</Step>
	<Step enable="True" id="87" name="Show Custom Dialog">
		<Title><Calculation><![CDATA["Stripe Error"]]></Calculation></Title>
		<Message><Calculation><![CDATA["Failed to attach card: " & $errorMessage]]></Calculation></Message>
		<Buttons><Button><Name>OK</Name><CommitChanges>Yes</CommitChanges></Button></Buttons>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA["error"]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"></Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 6: Set as the default payment method</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA["invoice_settings[default_payment_method]=" & $paymentMethodID]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$defaultData</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA["-X POST" & " -H \"Authorization: Bearer " & $apiKey & "\"" & " -H \"Stripe-Version: 2025-04-30\"" & " -H \"Content-Type: application/x-www-form-urlencoded\"" & " -d \"" & $defaultData & "\""]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$curlOptions</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[""]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$response</Name>
	</Step>
	<Step enable="True" id="136" name="Insert from URL">
		<SelectAll state="True"/>
		<NoDialog state="True"/>
		<Target><Variable value="$response"/></Target>
		<URL><Calculation><![CDATA["https://api.stripe.com/v1/customers/" & $customerID]]></Calculation></URL>
		<cURLOptions><Calculation><![CDATA[$curlOptions]]></Calculation></cURLOptions>
	</Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 7: Store the PaymentMethod token in FileMaker</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[JSONGetElement ( $response ; "card.last4" )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$last4</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[JSONGetElement ( $response ; "card.brand" )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$brand</Name>
	</Step>

	<Step enable="True" id="6" name="Go to Layout">
		<Layout id="0" name="PaymentMethods"/>
		<Animation value="None"/>
	</Step>
	<Step enable="True" id="56" name="New Record/Request"></Step>
	<Step enable="True" id="76" name="Set Field">
		<Field table="PaymentMethods" id="0" name="StripePaymentMethodID"/>
		<Calculation><![CDATA[$paymentMethodID]]></Calculation>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Field table="PaymentMethods" id="0" name="CustomerID_FK"/>
		<Calculation><![CDATA[Customers::CustomerID]]></Calculation>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Field table="PaymentMethods" id="0" name="StripeCustomerID"/>
		<Calculation><![CDATA[$customerID]]></Calculation>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Field table="PaymentMethods" id="0" name="CardLast4"/>
		<Calculation><![CDATA[$last4]]></Calculation>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Field table="PaymentMethods" id="0" name="CardBrand"/>
		<Calculation><![CDATA[$brand]]></Calculation>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Field table="PaymentMethods" id="0" name="IsDefault"/>
		<Calculation><![CDATA[1]]></Calculation>
	</Step>
	<Step enable="True" id="75" name="Commit Records/Requests">
		<NoDialog state="True"/>
	</Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 8: Update the customer record</Text></Step>
	<Step enable="True" id="6" name="Go to Layout">
		<Layout id="0" name="" destination="OriginalLayout"/>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Field table="Customers" id="0" name="DefaultPaymentMethod"/>
		<Calculation><![CDATA[$paymentMethodID]]></Calculation>
	</Step>
	<Step enable="True" id="75" name="Commit Records/Requests">
		<NoDialog state="True"/>
	</Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 9: Clear temporary card fields</Text></Step>
	<Step enable="True" id="76" name="Set Field">
		<Field table="Customers" id="0" name="TempCardNumber"/>
		<Calculation><![CDATA[""]]></Calculation>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Field table="Customers" id="0" name="TempExpMonth"/>
		<Calculation><![CDATA[""]]></Calculation>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Field table="Customers" id="0" name="TempExpYear"/>
		<Calculation><![CDATA[""]]></Calculation>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Field table="Customers" id="0" name="TempCVC"/>
		<Calculation><![CDATA[""]]></Calculation>
	</Step>
	<Step enable="True" id="75" name="Commit Records/Requests">
		<NoDialog state="True"/>
	</Step>

	<Step enable="True" id="87" name="Show Custom Dialog">
		<Title><Calculation><![CDATA["Success"]]></Calculation></Title>
		<Message><Calculation><![CDATA["Card added successfully (" & $brand & " ending in " & $last4 & ")"]]></Calculation></Message>
		<Buttons><Button><Name>OK</Name><CommitChanges>Yes</CommitChanges></Button></Buttons>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[$paymentMethodID]]></Calculation>
	</Step>
</fmxmlsnippet>
