<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
	<Step enable="True" id="89" name="Comment"><Text>Check Connected Account Status</Text></Step>
	<Step enable="True" id="89" name="Comment"><Text>Retrieves the current status of a connected Stripe Standard account</Text></Step>
	<Step enable="True" id="89" name="Comment"><Text>---</Text></Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 1: Get the platform's Stripe API key</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[GetFieldValue ( "StripeConfig::ApiKey" )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$apiKey</Name>
	</Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 2: Get the connected account ID</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[Get ( ScriptParameter )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$accountID</Name>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[IsEmpty ( $accountID )]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[ConnectedAccounts::StripeAccountID]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$accountID</Name>
	</Step>
	<Step enable="True" id="70" name="End If"></Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[IsEmpty ( $accountID )]]></Calculation>
	</Step>
	<Step enable="True" id="87" name="Show Custom Dialog">
		<Title><Calculation><![CDATA["Error"]]></Calculation></Title>
		<Message><Calculation><![CDATA["No Stripe connected account ID found."]]></Calculation></Message>
		<Buttons><Button><Name>OK</Name><CommitChanges>Yes</CommitChanges></Button></Buttons>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA["error"]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"></Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 3: Retrieve the account</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA["-X GET" & " -H \"Authorization: Bearer " & $apiKey & "\"" & " -H \"Stripe-Version: 2025-04-30\""]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$curlOptions</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[""]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$response</Name>
	</Step>
	<Step enable="True" id="136" name="Insert from URL">
		<SelectAll state="True"/>
		<NoDialog state="True"/>
		<Target><Variable value="$response"/></Target>
		<URL><Calculation><![CDATA["https://api.stripe.com/v1/accounts/" & $accountID]]></Calculation></URL>
		<cURLOptions><Calculation><![CDATA[$curlOptions]]></Calculation></cURLOptions>
	</Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 4: Check for errors</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[JSONGetElement ( $response ; "error.message" )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$errorMessage</Name>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( $errorMessage )]]></Calculation>
	</Step>
	<Step enable="True" id="87" name="Show Custom Dialog">
		<Title><Calculation><![CDATA["Stripe Error"]]></Calculation></Title>
		<Message><Calculation><![CDATA["Failed to retrieve account: " & $errorMessage]]></Calculation></Message>
		<Buttons><Button><Name>OK</Name><CommitChanges>Yes</CommitChanges></Button></Buttons>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA["error"]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"></Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 5: Extract account status</Text></Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[JSONGetElement ( $response ; "charges_enabled" )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$chargesEnabled</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[JSONGetElement ( $response ; "payouts_enabled" )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$payoutsEnabled</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[JSONGetElement ( $response ; "business_profile.name" )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$businessName</Name>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Value><Calculation><![CDATA[JSONGetElement ( $response ; "email" )]]></Calculation></Value>
		<Repetition><Calculation><![CDATA[1]]></Calculation></Repetition>
		<Name>$email</Name>
	</Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 6: Update FileMaker record</Text></Step>
	<Step enable="True" id="76" name="Set Field">
		<Field table="ConnectedAccounts" id="0" name="ChargesEnabled"/>
		<Calculation><![CDATA[$chargesEnabled]]></Calculation>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Field table="ConnectedAccounts" id="0" name="PayoutsEnabled"/>
		<Calculation><![CDATA[$payoutsEnabled]]></Calculation>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Field table="ConnectedAccounts" id="0" name="BusinessName"/>
		<Calculation><![CDATA[$businessName]]></Calculation>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Field table="ConnectedAccounts" id="0" name="LastChecked"/>
		<Calculation><![CDATA[Get ( CurrentTimestamp )]]></Calculation>
	</Step>
	<Step enable="True" id="75" name="Commit Records/Requests">
		<NoDialog state="True"/>
	</Step>

	<Step enable="True" id="89" name="Comment"><Text>Step 7: Display status</Text></Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[$chargesEnabled = "true"]]></Calculation>
	</Step>
	<Step enable="True" id="87" name="Show Custom Dialog">
		<Title><Calculation><![CDATA["Account Active"]]></Calculation></Title>
		<Message><Calculation><![CDATA["Account " & $accountID & " is ready to accept charges." & ¶ & "Business: " & $businessName & ¶ & "Email: " & $email & ¶ & "Charges: Enabled" & ¶ & "Payouts: " & If ( $payoutsEnabled = "true" ; "Enabled" ; "Disabled" )]]></Calculation></Message>
		<Buttons><Button><Name>OK</Name><CommitChanges>Yes</CommitChanges></Button></Buttons>
	</Step>
	<Step enable="True" id="69" name="Else"></Step>
	<Step enable="True" id="87" name="Show Custom Dialog">
		<Title><Calculation><![CDATA["Account Not Ready"]]></Calculation></Title>
		<Message><Calculation><![CDATA["Account " & $accountID & " cannot accept charges yet." & ¶ & "Business: " & $businessName & ¶ & "Charges: Disabled" & ¶ & "Payouts: " & If ( $payoutsEnabled = "true" ; "Enabled" ; "Disabled" ) & ¶ & ¶ & "The user may need to complete additional verification in their Stripe Dashboard at dashboard.stripe.com."]]></Calculation></Message>
		<Buttons><Button><Name>OK</Name><CommitChanges>Yes</CommitChanges></Button></Buttons>
	</Step>
	<Step enable="True" id="70" name="End If"></Step>

	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[If ( $chargesEnabled = "true" ; "active" ; "inactive" )]]></Calculation>
	</Step>
</fmxmlsnippet>
